.shop-panel {
    background-color: rgba(18, 16, 28, 0.88);
    border-top-width: 2px;
    border-top-color: rgba(255, 255, 255, 0.12);
    padding: 10px 16px;
    transition-property: background-color, border-top-color;
    transition-duration: 0.12s;
}

/* While a held hero hovers the shop, dropping it here sells it - say so before the drop
   happens, since the bench sits directly above and a slightly low drop would otherwise
   delete a hero with no warning (see PlayerController.DropHero). */
.shop-panel--selling {
    background-color: rgba(64, 16, 22, 0.92);
    border-top-color: rgba(232, 84, 84, 0.9);
}

.shop-slots-container {
    flex-grow: 1;
    flex-direction: row;
    justify-content: flex-start;
    align-items: stretch;
    flex-wrap: nowrap;
    align-self: auto;
    height: 100%;
    align-content: flex-start;
}

#RandomSlot {
    margin-right: 12px;
}

.hero-slot {
    /* flex-grow alone distributes *extra* space equally as an add-on to each item's own
       content-driven starting size (flex-basis: auto) - a longer label still ends up wider.
       flex-basis: 0 makes every slot start from the same baseline so equal growth produces
       equal final widths; min-width: 0 additionally lets a slot shrink below its label's
       content size if the row is ever squeezed tighter than 5 slots' worth of text. */
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin-left: 6px;
    margin-right: 6px;
    padding: 10px 4px;
    background-color: rgba(255, 255, 255, 0.06);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.16);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    transition-property: background-color, border-color;
    transition-duration: 0.12s;
}

.hero-slot:hover {
    background-color: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.32);
}

.hero-slot:active {
    background-color: rgba(255, 255, 255, 0.2);
}

.hero-slot-label {
    color: rgb(232, 230, 240);
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
}

/* Dragged-hero preview that follows the pointer while holding a shop slot. It carries .hero-slot
   as well (see Ghost.uxml), so everything about how it LOOKS - background, border, radius, and the
   label inside it - is the slot's, not a second set of values here that would have to be kept in
   step by hand. What is left below is only what a slot cannot say about itself: that this one is
   out of the layout and in hand. Declared after .hero-slot deliberately - equal specificity, so
   on the properties they share these win.

   Width and height are a fallback: ShopPanelController.ShowGhostAs overwrites them inline with
   the measured size of the slot actually being dragged, so the card does not change size the
   moment you pick it up. They matter only if the ghost is somehow shown without that call. */
.ghost {
    position: absolute;
    width: 96px;
    height: 56px;
    margin-left: 0;
    margin-right: 0;
    /* reads as held rather than at rest: a brighter edge than .hero-slot's, and slightly
       see-through so the board and the bench stay legible while you decide where to drop. */
    border-color: rgba(255, 255, 255, 0.85);
    opacity: 0.9;
}

.refresh-slot {
    flex-grow: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin-left: 6px;
    margin-right: 6px;
    padding: 2px 4px;
    background-color: rgba(255, 255, 255, 0.06);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.16);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    transition-property: background-color, border-color;
    transition-duration: 0.12s;
    margin-top: 4px;
    margin-bottom: 4px;
    width: 100%;
}
