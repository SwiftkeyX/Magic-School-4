/* Reward panel - the stage-win item offer.
   Palette matches MatchStatus.uss and Shop.uss so all three read as one UI. */

/* Fills the RewardPanel overlay, which is absolutely positioned over the whole screen
   rather than over one row - the card is a modal choice, so it centres against everything
   including the shop and the bench, not just the board. */
.reward-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(10, 9, 16, 0.55);
}

/* ---------------- the card ---------------- */
/* The card is the whole screen, not a panel floating on the board: winning a stage stops the
   run to ask one question, and nothing behind it is worth reading while it is up. Hence no
   corner radius and no border - it has no edge to draw, it IS the edge. Opaque rather than
   nearly so: at 0.97 the board and the shop still read clearly through it, and three item
   names over a hex grid are harder to compare than three over nothing. */
.reward-card {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    background-color: rgb(18, 16, 28);
}

/* Anchored to the card's top-right corner, which is now the screen's. Absolute so the title
   below stays centred on the card rather than being pushed off-centre by a button sharing
   its row. */
.reward-card__close {
    position: absolute;
    top: 18px;
    right: 22px;
    width: 40px;
    height: 40px;
    margin: 0;
    padding: 0;
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgba(232, 230, 240, 0.7);
    background-color: rgba(255, 255, 255, 0.06);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.16);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    transition-property: background-color, border-color, color;
    transition-duration: 0.12s;
}

.reward-card__close:hover {
    color: rgb(240, 240, 248);
    background-color: rgba(255, 255, 255, 0.14);
    border-color: rgba(255, 255, 255, 0.34);
}

.reward-card__close:active {
    background-color: rgba(255, 255, 255, 0.22);
}

.reward-card__title {
    font-size: 40px;
    letter-spacing: 5px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(240, 240, 248);
    margin-bottom: 6px;
}

.reward-card__hint {
    font-size: 20px;
    -unity-text-align: middle-center;
    color: rgba(232, 230, 240, 0.6);
    margin-bottom: 28px;
}

/* ---------------- the three offers ---------------- */
.reward-slots {
    flex-direction: row;
    align-items: stretch;
    justify-content: center;
}

/* Fixed size rather than flex-grow, unlike .hero-slot in the shop: a shop slot divides a row
   that is already as wide as the screen, and so would these now that the card is the screen -
   three offers stretched across a monitor is a worse read than three cards of a size the eye
   can take in at once. The height is fixed for the same reason the width is: an offer of a
   long description should not be a taller card than the two beside it. */
.item-slot {
    width: 220px;
    height: 240px;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    margin-left: 20px;
    margin-right: 20px;
    /* top padding rather than centring the block: centred, a two-line description and a
       four-line one put their item names at different heights, and the three names are what
       the eye compares first. */
    padding: 48px 16px 18px;
    background-color: rgba(255, 255, 255, 0.06);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.16);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    transition-property: background-color, border-color;
    transition-duration: 0.12s;
    
}

.item-slot:hover {
    background-color: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.32);
}

.item-slot:active {
    background-color: rgba(255, 255, 255, 0.2);
}

.item-slot__name {
    color: rgb(232, 230, 240);
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 10px;
}

/* The blue the winner banner and the HP bar already use, rather than a fourth accent. */
.item-slot__description {
    color: rgba(180, 205, 245, 0.85);
    font-size: 18px;
    -unity-text-align: middle-center;
    white-space: normal;
}

/* An offer with no ItemDataSO behind it - the slot keeps its place in the row so a card of
   two offers is still laid out like a card of three. */
.item-slot--empty {
    opacity: 0.35;
}

/* Hidden state. display:none rather than opacity, so a hidden card cannot sit invisibly
   over the board eating pointer events meant for a hex. */
.is-hidden {
    display: none;
}
